generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER_ADMIN
  SELLER
  STAFF
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
}

enum Marketplace {
  AMAZON
  FLIPKART
  MEESHO
  SHOPIFY
  WOOCOMMERCE
  EBAY
  ETSY
  WALMART
  OTHER
}

enum CommissionStatus {
  PENDING
  PAID
  VOID
}

enum OrderStatus {
  DRAFT
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

model Tenant {
  id             String                 @id @default(cuid())
  businessName   String
  preferredLanguage String              @default("mr")
  createdAt      DateTime               @default(now())
  users          User[]
  stores         Store[]
  products       Product[]
  orders         Order[]
  connections    MarketplaceConnection[]
  subscription   Subscription?
  commissions    CommissionLedger[]
}

model User {
  id                String        @id @default(cuid())
  tenantId          String?
  tenant            Tenant?       @relation(fields: [tenantId], references: [id])
  email             String?       @unique
  phone             String?       @unique
  passwordHash      String?
  preferredLanguage String        @default("mr")
  role              UserRole      @default(SELLER)
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  auditLogs         AuditLog[]
  sessions          UserSession[]
}

model Store {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  slug      String   @unique
  currency  String   @default("INR")
  createdAt DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  title       String
  description String?
  sku         String?
  price       Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  @@index([tenantId])
}

model Order {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  orderNumber String
  status      OrderStatus @default(PLACED)
  total       Decimal     @db.Decimal(12, 2)
  createdAt   DateTime    @default(now())
  commission  CommissionLedger?
  @@unique([tenantId, orderNumber])
  @@index([tenantId, status, createdAt])
}

model MarketplaceConnection {
  id                  String      @id @default(cuid())
  tenantId            String
  tenant              Tenant      @relation(fields: [tenantId], references: [id])
  marketplace         Marketplace
  status              String      @default("NOT_CONNECTED")
  encryptedCredentials String?
  createdAt           DateTime    @default(now())
  @@unique([tenantId, marketplace])
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  code        String   @unique
  displayName String
  monthlyPrice Decimal @default(0) @db.Decimal(12, 2)
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model Subscription {
  id              String             @id @default(cuid())
  tenantId        String             @unique
  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  status          SubscriptionStatus @default(TRIAL)
  planCode        String             @default("FREE")
  priceAtPurchase Decimal            @default(0) @db.Decimal(12, 2)
  currentPeriodEnd DateTime?
  gracePeriodEndsAt DateTime?
  paymentReference String?
  updatedAt       DateTime @updatedAt
}

model CommissionLedger {
  id                 String           @id @default(cuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  orderId            String           @unique
  order              Order            @relation(fields: [orderId], references: [id])
  grossAmount        Decimal          @db.Decimal(12, 2)
  commissionRateBps  Int              @default(800)
  commissionAmount   Decimal          @db.Decimal(12, 2)
  sellerNetAmount    Decimal          @db.Decimal(12, 2)
  status             CommissionStatus @default(PENDING)
  paymentReference   String?
  notes              String?
  createdAt          DateTime         @default(now())
  settledAt          DateTime?
  @@index([tenantId, status, createdAt])
  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  createdAt  DateTime @default(now())
  @@index([userId, createdAt])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  identifier String
  codeHash   String
  purpose    String    @default("LOGIN")
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  @@index([identifier, createdAt])
  @@index([expiresAt])
}

model UserSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  @@index([userId, expiresAt])
}
